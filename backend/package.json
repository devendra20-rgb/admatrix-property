{
  "name": "admatrix-property-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "test": "tsx src/verify-integration.ts",
    "test:api": "tsx src/test-api-endpoints.ts",
    "test:auth": "tsx src/test-auth-rbac-tenancy.ts",
    "test:security": "tsx src/test-negative-security.ts",
    "test:media": "tsx src/test-s3-media-storage.ts",
    "test:all": "tsx src/verify-integration.ts && tsx src/test-api-endpoints.ts && tsx src/test-auth-rbac-tenancy.ts && tsx src/test-negative-security.ts && tsx src/test-s3-media-storage.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.9",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
